{
  "name": "bhw-render-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "test": "node --import tsx --test ci-tests/api.integration.mjs ci-tests/workbook.mjs ci-tests/security.mjs ci-tests/household-profile.mjs ci-tests/household-summary-export.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "export:d1": "node --env-file-if-exists=.env --import tsx scripts/migrate-d1-json.ts export",
    "import:d1-json": "node --env-file-if-exists=.env --import tsx scripts/migrate-d1-json.ts import"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^5.1.0",
    "fflate": "0.7.4",
    "mongodb": "^6.19.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
