# Use a local MongoDB server or a separate development database in Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=bhw_local

# Local-only secrets. Replace these before sharing or deploying.
SESSION_SECRET=change-this-local-session-secret-before-use
ADMIN_SETUP_TOKEN=change-this-local-admin-setup-token
PORT=10000
FRONTEND_ORIGIN=http://localhost:3000
